{
  "name": "tele-photo",
  "private": true,
  "version": "0.2.0",
  "description": "A Google Photos alternative that stores your originals in your own Telegram account, and runs entirely in the browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter ./web dev",
    "build": "pnpm --filter ./web build",
    "preview": "pnpm --filter ./web preview",
    "test": "pnpm --filter ./web test",
    "android:keystore": "sh android/scripts/make-keystore.sh",
    "android:apk": "sh android/scripts/build-apk.sh",
    "android:demo": "sh android/scripts/build-apk.sh demo"
  }
}
